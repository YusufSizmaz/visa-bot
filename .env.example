# Bu dosyayi ".env" adiyla kopyalayip degerleri doldurun. ".env" git'e gonderilmez.

# PostgreSQL "postgres" kullanicisinin sifresi.
POSTGRES_PASSWORD=VisaBot_Dev_Passw0rd!

# Yonetim API'si anahtari (en az 16 karakter). Uretimde uzun ve rastgele bir deger kullanin.
API_KEY=dev-api-key-change-me-please

# BotFather'dan alinan token ve botun yonetici oldugu kanal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@kanal_adiniz
